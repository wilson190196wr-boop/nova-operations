# Modèle des variables d'environnement. Copiez-le en `.env.local` pour le
# développement, et reportez les mêmes valeurs chez l'hébergeur pour la
# production. `.env.local` n'est jamais versionné.
#
# Règle de lecture : tout ce qui commence par NEXT_PUBLIC_ est figé dans le
# code envoyé au navigateur et donc public. Tout le reste ne doit jamais y
# arriver.

# --- Sanity : identification du projet ---------------------------------
# Les deux seules valeurs indispensables pour que le site démarre. Sans elles,
# la construction échoue avec un message nommant la variable manquante — plutôt
# qu'un site qui se lance en affichant des pages vides.
# Elles se lisent dans sanity.io/manage, ou dans la sortie de `sanity init`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Version de l'API Sanity, figée à une date. Ne la remplacez pas par une date
# calculée : c'est ce qui garantit qu'une évolution côté Sanity ne change pas
# le rendu du site sans décision.
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-14

# Adresse du Studio. Il est servi par ce site sur /studio ; une URL absolue
# n'est nécessaire que s'il est déployé séparément.
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio

# --- Sanity : jeton de lecture (serveur uniquement) --------------------
# Nécessaire uniquement pour la prévisualisation des brouillons. Le site public
# n'en a pas besoin : il ne lit que le contenu publié.
# Créez-le dans sanity.io/manage > API > Tokens, avec les droits « Viewer » —
# le minimum qui permette de lire les brouillons, et rien de plus.
SANITY_API_READ_TOKEN=

# --- Sanity : secret du webhook de publication -------------------------
# Partagé entre ce site et le webhook configuré dans Sanity. Il authentifie
# l'appel qui rafraîchit les pages après une publication ; sans lui, n'importe
# qui pourrait déclencher des régénérations en boucle.
# Générez une valeur aléatoire, par exemple avec : openssl rand -base64 32
SANITY_REVALIDATE_SECRET=

# --- Sanity : jeton d'écriture (scripts locaux uniquement) -------------
# Utilisé seulement par `scripts/reprise-contenus.ts`, jamais par le site.
# Droits « Editor ». À NE PAS déclarer chez l'hébergeur : le site n'écrit
# jamais dans Sanity, et un jeton d'écriture en production est une surface
# d'attaque sans contrepartie.
SANITY_API_WRITE_TOKEN=

# --- Prise de rendez-vous (Cal.com) ------------------------------------
# Facultatif : le lien réel est la valeur par défaut dans src/lib/booking.ts.
# À renseigner seulement pour pointer un autre type d'événement.
NEXT_PUBLIC_CAL_LINK=wilson-rault-vclkvp/45min

# --- Formulaire de contact (Brevo) -------------------------------------
# Sans clé, le formulaire n'envoie rien : il affiche « L'envoi est
# momentanément indisponible » et renvoie vers l'adresse de contact.
# Clé API : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Destinataire des demandes. À défaut, l'adresse saisie dans les réglages du
# site (Studio) sert de repli.
CONTACT_TO=wilson@keleria.com

# Expéditeur. L'adresse doit être validée dans Brevo (Expéditeurs > Ajouter),
# ou appartenir à un domaine authentifié chez eux. À défaut, le nom du site et
# son adresse, tels qu'ils sont saisis dans le Studio, servent de repli.
CONTACT_FROM_NAME=Site KELERIA
CONTACT_FROM_EMAIL=wilson@keleria.com
