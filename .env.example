# Modèle des variables d'environnement. Copiez-le en `.env.local` pour le
# développement, et reportez les mêmes valeurs chez l'hébergeur pour la
# production. `.env.local` n'est jamais versionné.

# --- Prise de rendez-vous (Cal.com) ------------------------------------
# Facultatif : le lien réel est la valeur par défaut dans src/lib/booking.ts.
# À renseigner seulement pour pointer un autre type d'événement.
NEXT_PUBLIC_CAL_LINK=wilson-rault-vclkvp/45min

# --- Formulaire de contact (Brevo) -------------------------------------
# Sans clé, le formulaire n'envoie rien : il affiche « L'envoi est
# momentanément indisponible » et renvoie vers l'adresse de contact.
# Clé API : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Destinataire des demandes. À défaut, `site.email` sert de repli.
CONTACT_TO=wilson@keleria.com

# Expéditeur. L'adresse doit être validée dans Brevo (Expéditeurs > Ajouter),
# ou appartenir à un domaine authentifié chez eux. À défaut, le nom du site et
# `site.email` servent de repli.
CONTACT_FROM_NAME=Site KELERIA
CONTACT_FROM_EMAIL=wilson@keleria.com
