# --- Prise de rendez-vous (Cal.com) ------------------------------------
# Identifiant public du type d'événement : "<équipe-ou-utilisateur>/<event-type>"
NEXT_PUBLIC_CAL_LINK=nova-operations/diagnostic-45min

# --- Formulaire de contact (Resend) ------------------------------------
# Clé API : https://resend.com/api-keys
RESEND_API_KEY=

# Expéditeur : le domaine doit être vérifié dans Resend (DNS SPF + DKIM)
CONTACT_FROM=Site NOVA <site@nova-operations.fr>

# Destinataire des demandes
CONTACT_TO=contact@nova-operations.fr
